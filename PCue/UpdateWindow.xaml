<Window x:Class="PCue.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="업데이트"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource TextPrimary}"
        FontSize="13"
        ShowInTaskbar="False"
        Closing="Window_OnClosing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource BgDeep}"
            BorderBrush="{StaticResource Line}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <DockPanel>
            <Border DockPanel.Dock="Top"
                    Height="40"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,0,1">
                <TextBlock Text="업데이트"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           FontWeight="SemiBold"
                           FontSize="13" />
            </Border>

            <StackPanel Margin="20">
                <TextBlock x:Name="MessageText"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"
                           FontSize="14" />

                <TextBlock x:Name="BusyText"
                           Text="업데이트를 받는 중입니다. 끝날 때까지 프로그램을 종료할 수 없습니다."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,0,0,10"
                           Visibility="Collapsed" />

                <ProgressBar x:Name="Progress"
                             Height="6"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Margin="0,0,0,6"
                             Visibility="Collapsed"
                             Foreground="{StaticResource Accent}"
                             Background="{StaticResource BgElevated}"
                             BorderThickness="0" />

                <TextBlock x:Name="PercentText"
                           Text="0%"
                           FontFamily="{StaticResource MonoFont}"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="12"
                           Margin="0,0,0,14"
                           Visibility="Collapsed" />

                <TextBlock x:Name="ErrorText"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Danger}"
                           Margin="0,0,0,14"
                           Visibility="Collapsed" />

                <StackPanel x:Name="ButtonRow"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="다음에"
                            Width="96"
                            Height="32"
                            Margin="0,0,8,0"
                            Click="Later_OnClick"
                            Background="{StaticResource BgElevated}"
                            Foreground="{StaticResource TextPrimary}" />
                    <Button x:Name="UpdateButton"
                            Content="지금 업데이트"
                            Width="120"
                            Height="32"
                            Margin="0"
                            Click="Update_OnClick"
                            Background="{StaticResource Accent}"
                            Foreground="{StaticResource TextOnAccent}"
                            FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
