<Window x:Class="PCue.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:PCue.ViewModels"
        mc:Ignorable="d"
        Title="PCue"
        Height="700"
        Width="1000"
        MinHeight="520"
        MinWidth="780"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource AppFont}"
        Focusable="True"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="10"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            Background="{StaticResource BgDeep}"
            BorderBrush="{StaticResource Line}"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title / control header -->
            <Border x:Name="TitleBarBorder"
                    Grid.Row="0"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <DockPanel Margin="14,0,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource CaptionButton}" Content="─" Click="Minimize_OnClick" ToolTip="최소화" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="□" Click="Maximize_OnClick" ToolTip="최대화" />
                        <Button Style="{StaticResource CaptionCloseButton}" Content="✕" Click="Close_OnClick" ToolTip="닫기" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PCue"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,20,0"
                                   IsHitTestVisible="False" />
                        <Border Width="1" Height="18" Background="{StaticResource Line}" Margin="0,0,16,0" />
                        <TextBlock Text="출력"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   FontSize="12"
                                   shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <ComboBox ItemsSource="{Binding Displays}"
                                  SelectedItem="{Binding SelectedDisplay}"
                                  Width="240"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Content="새로고침"
                                Style="{StaticResource ToolButton}"
                                Command="{Binding RefreshDisplaysCommand}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <CheckBox Content="영상 출력"
                                  IsChecked="{Binding IsOutputEnabled}"
                                  Margin="8,0,0,0"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center"
                                   Margin="20,0,16,0"
                                   FontSize="12"
                                   IsHitTestVisible="False" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Playlist panel -->
                <Border Grid.Row="0"
                        Background="{StaticResource BgPanel}"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="12,10,12,8" LastChildFill="False">
                            <TextBlock Text="재생 목록"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="파일을 끌어다 놓아 추가"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="추가" Style="{StaticResource ToolButton}" Command="{Binding AddFilesCommand}" />
                                <Button Content="제거" Style="{StaticResource ToolButton}" Command="{Binding RemoveSelectedCommand}" />
                                <Button Content="위로" Style="{StaticResource ToolButton}" Command="{Binding MoveUpCommand}" />
                                <Button Content="아래로" Style="{StaticResource ToolButton}" Command="{Binding MoveDownCommand}" Margin="0" />
                            </StackPanel>
                        </DockPanel>

                        <ListBox x:Name="PlaylistBox"
                                 Grid.Row="1"
                                 Margin="8,0,8,8"
                                 ItemsSource="{Binding Playlist}"
                                 SelectedItem="{Binding SelectedItem}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 AllowDrop="True"
                                 DragOver="PlaylistBox_OnDragOver"
                                 Drop="PlaylistBox_OnDrop"
                                 MouseDoubleClick="PlaylistBox_OnMouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="40" Margin="0">
                                        <Border x:Name="PlayBg" Background="Transparent" />
                                        <Border x:Name="AccentBar"
                                                Width="3"
                                                HorizontalAlignment="Left"
                                                Background="Transparent"
                                                CornerRadius="0,2,2,0" />
                                        <DockPanel Margin="14,8,12,8">
                                            <TextBlock Text="{Binding Number, StringFormat={}{0}}"
                                                       DockPanel.Dock="Left"
                                                       Width="28"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <Border x:Name="TypeChip"
                                                    DockPanel.Dock="Left"
                                                    Background="{StaticResource BgElevated}"
                                                    CornerRadius="4"
                                                    Padding="7,2"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Name="TypeText"
                                                           Text="{Binding SourceType}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMuted}" />
                                            </Border>
                                            <TextBlock Text="{Binding DurationText}"
                                                       DockPanel.Dock="Right"
                                                       Width="52"
                                                       TextAlignment="Right"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0" />
                                            <TextBlock Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       FontSize="13"
                                                       ToolTip="{Binding FilePath}" />
                                        </DockPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter TargetName="PlayBg" Property="Background" Value="{StaticResource AccentDim}" />
                                            <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource Accent}" />
                                            <Setter TargetName="TypeChip" Property="Background" Value="{StaticResource Accent}" />
                                            <Setter TargetName="TypeText" Property="Foreground" Value="#0B0E13" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Transport deck -->
                <Border Grid.Row="1"
                        Margin="0,12,0,0"
                        Background="{StaticResource BgPanel}"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="{Binding TimeText}"
                                       DockPanel.Dock="Right"
                                       VerticalAlignment="Center"
                                       MinWidth="120"
                                       TextAlignment="Right"
                                       Margin="14,0,0,0"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="13"
                                       Foreground="{StaticResource Accent}"
                                       Cursor="Hand"
                                       Background="Transparent"
                                       ToolTip="클릭: 경과/남은 시간 전환">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding ToggleTimeDisplayCommand}" />
                                </TextBlock.InputBindings>
                            </TextBlock>
                            <Slider x:Name="SeekSlider"
                                    Style="{StaticResource SeekSlider}"
                                    Minimum="0"
                                    Maximum="{Binding DurationMs}"
                                    Value="{Binding PositionMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsSnapToTickEnabled="False"
                                    LargeChange="1000"
                                    SmallChange="100"
                                    PreviewMouseLeftButtonDown="SeekSlider_OnPreviewMouseLeftButtonDown"
                                    PreviewMouseMove="SeekSlider_OnPreviewMouseMove"
                                    PreviewMouseLeftButtonUp="SeekSlider_OnPreviewMouseLeftButtonUp"
                                    VerticalAlignment="Center" />
                        </DockPanel>

                        <DockPanel Grid.Row="1" LastChildFill="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="이전" Style="{StaticResource TransportButton}" Command="{Binding PreviousCommand}" />
                                <Button Content="재생" Style="{StaticResource PlayButton}" Command="{Binding PlayCommand}" />
                                <Button Content="일시정지" Style="{StaticResource TransportButton}" Command="{Binding PauseCommand}" />
                                <Button Content="정지" Style="{StaticResource TransportButton}" Command="{Binding StopCommand}" />
                                <Button Content="다음" Style="{StaticResource TransportButton}" Command="{Binding NextCommand}" />
                                <CheckBox Content="자동 다음"
                                          IsChecked="{Binding AutoAdvance}"
                                          Margin="16,0,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        DockPanel.Dock="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="볼륨"
                                           Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           FontSize="12" />
                                <Slider Width="140"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{Binding Volume}"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Volume, StringFormat={}{0:0}}"
                                           Width="28"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource MonoFont}"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="12" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
