<Window x:Class="PCue.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:PCue.ViewModels"
        mc:Ignorable="d"
        Title="PCue — 피큐"
        Icon="pack://application:,,,/Assets/Images/favicon.ico"
        Height="700"
        Width="1000"
        MinHeight="520"
        MinWidth="780"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource AppFont}"
        Focusable="True"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="10"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            Background="{StaticResource BgDeep}"
            BorderBrush="{StaticResource Line}"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title / control header -->
            <Border x:Name="TitleBarBorder"
                    Grid.Row="0"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <DockPanel Margin="14,0,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource CaptionButton}"
                                Content="{StaticResource GlyphChromeMinimize}"
                                Click="Minimize_OnClick"
                                ToolTip="최소화" />
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource CaptionButton}"
                                Content="{StaticResource GlyphChromeMaximize}"
                                Click="Maximize_OnClick"
                                ToolTip="최대화" />
                        <Button Style="{StaticResource CaptionCloseButton}"
                                Content="{StaticResource GlyphChromeClose}"
                                Click="Close_OnClick"
                                ToolTip="닫기" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/Images/Logo_B.png"
                               Width="22"
                               Height="22"
                               Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               IsHitTestVisible="False" />
                        <TextBlock Text="PCue"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                        <TextBlock Text="피큐"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center"
                                   Margin="7,1,16,0"
                                   IsHitTestVisible="False" />

                        <Border Width="1" Height="16" Background="{StaticResource Line}" Margin="0,0,14,0" />

                        <TextBlock Text="출력"
                                   Style="{StaticResource SectionLabel}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   IsHitTestVisible="False" />
                        <ComboBox ItemsSource="{Binding Displays}"
                                  SelectedItem="{Binding SelectedDisplay}"
                                  Width="210"
                                  Height="30"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Style="{StaticResource IconButton}"
                                Command="{Binding RefreshDisplaysCommand}"
                                ToolTip="디스플레이 새로고침"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource GlyphRefresh}" />
                        </Button>
                        <CheckBox Content="영상 출력"
                                  IsChecked="{Binding IsOutputEnabled}"
                                  Margin="6,0,0,0"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />

                        <Border Style="{StaticResource StatusChip}" Margin="14,0,12,0" MaxWidth="220">
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False" />
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1" Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Playlist panel -->
                <Border Grid.Row="0"
                        Background="{StaticResource BgPanel}"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                BorderBrush="{StaticResource Line}"
                                BorderThickness="0,0,0,1"
                                Padding="14,11">
                            <DockPanel LastChildFill="False">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="재생 목록"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Border Background="{StaticResource BgElevated}"
                                            CornerRadius="8"
                                            Padding="7,1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PlaylistCount}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMuted}" />
                                    </Border>
                                    <TextBlock Text="파일을 끌어다 놓아 추가"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource ToolButton}"
                                            Command="{Binding AddFilesCommand}"
                                            ToolTip="추가">
                                        <TextBlock Style="{StaticResource IconGlyph}"
                                                   Text="{StaticResource GlyphAdd}"
                                                   Foreground="{StaticResource Accent}" />
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}"
                                            Command="{Binding RemoveSelectedCommand}"
                                            ToolTip="제거">
                                        <TextBlock Style="{StaticResource IconGlyph}"
                                                   Text="{StaticResource GlyphRemove}"
                                                   Foreground="{StaticResource Danger}" />
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}"
                                            Command="{Binding MoveUpCommand}"
                                            ToolTip="위로">
                                        <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource GlyphUp}" />
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}"
                                            Command="{Binding MoveDownCommand}"
                                            ToolTip="아래로"
                                            Margin="0">
                                        <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource GlyphDown}" />
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ListBox x:Name="PlaylistBox"
                                 Grid.Row="1"
                                 Margin="6,4,6,8"
                                 ItemsSource="{Binding Playlist}"
                                 SelectedItem="{Binding SelectedItem}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 AllowDrop="True"
                                 DragOver="PlaylistBox_OnDragOver"
                                 Drop="PlaylistBox_OnDrop"
                                 MouseDoubleClick="PlaylistBox_OnMouseDoubleClick">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="42" Margin="0">
                                        <Border x:Name="PlayBg" Background="Transparent" CornerRadius="5" Margin="2,1" />
                                        <Border x:Name="AccentBar"
                                                Width="3"
                                                Margin="2,5,0,5"
                                                HorizontalAlignment="Left"
                                                Background="Transparent"
                                                CornerRadius="2" />
                                        <DockPanel Margin="14,8,12,8">
                                            <TextBlock Text="{Binding Number, StringFormat={}{0:00}}"
                                                       DockPanel.Dock="Left"
                                                       MinWidth="28"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <Border x:Name="TypeChip"
                                                    DockPanel.Dock="Left"
                                                    Background="{StaticResource BgElevated}"
                                                    CornerRadius="4"
                                                    Padding="7,2"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Name="TypeText"
                                                           Text="{Binding SourceType}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMuted}" />
                                            </Border>
                                            <TextBlock Text="{Binding DurationText}"
                                                       DockPanel.Dock="Right"
                                                       MinWidth="52"
                                                       TextAlignment="Right"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0" />
                                            <TextBlock Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       FontSize="13"
                                                       ToolTip="{Binding FilePath}" />
                                        </DockPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter TargetName="PlayBg" Property="Background" Value="{StaticResource AccentDim}" />
                                            <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource Accent}" />
                                            <Setter TargetName="TypeChip" Property="Background" Value="{StaticResource Accent}" />
                                            <Setter TargetName="TypeText" Property="Foreground" Value="{StaticResource TextOnAccent}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPlaylistItems}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="재생 목록이 비어 있습니다"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="13"
                                       FontWeight="Medium" />
                            <TextBlock Text="파일을 추가하거나 끌어다 놓으세요"
                                       HorizontalAlignment="Center"
                                       Foreground="#FF5C6A7A"
                                       FontSize="12"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Transport deck -->
                <Border Grid.Row="1"
                        Margin="0,10,0,0"
                        Background="{StaticResource BgPanel}"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <Border DockPanel.Dock="Right"
                                    Background="{StaticResource BgElevated}"
                                    CornerRadius="6"
                                    Padding="10,6"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    ToolTip="경과 시간 ↔ 남은 시간">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding ToggleTimeDisplayCommand}" />
                                </Border.InputBindings>
                                <TextBlock Text="{Binding TimeText}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource Accent}" />
                            </Border>
                            <Slider x:Name="SeekSlider"
                                    Style="{StaticResource SeekSlider}"
                                    Minimum="0"
                                    Maximum="{Binding DurationMs}"
                                    Value="{Binding PositionMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsSnapToTickEnabled="False"
                                    LargeChange="1000"
                                    SmallChange="100"
                                    PreviewMouseLeftButtonDown="SeekSlider_OnPreviewMouseLeftButtonDown"
                                    PreviewMouseMove="SeekSlider_OnPreviewMouseMove"
                                    PreviewMouseLeftButtonUp="SeekSlider_OnPreviewMouseLeftButtonUp"
                                    LostMouseCapture="SeekSlider_OnLostMouseCapture"
                                    VerticalAlignment="Center" />
                        </DockPanel>

                        <DockPanel Grid.Row="1" LastChildFill="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource TransportButton}"
                                        Command="{Binding PreviousCommand}"
                                        ToolTip="이전">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconGlyph}"
                                                   Text="{StaticResource GlyphPrevious}"
                                                   FontSize="12"
                                                   Margin="0,0,6,0" />
                                        <TextBlock Text="이전" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PlayButton}"
                                        Command="{Binding PlayCommand}"
                                        ToolTip="재생">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconGlyph}"
                                                   Text="{StaticResource GlyphPlay}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextOnAccent}"
                                                   Margin="0,0,6,0" />
                                        <TextBlock Text="재생" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource TransportButton}"
                                        Command="{Binding PauseCommand}"
                                        ToolTip="일시정지">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconGlyph}"
                                                   Text="{StaticResource GlyphPause}"
                                                   FontSize="12"
                                                   Margin="0,0,6,0" />
                                        <TextBlock Text="일시정지" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource TransportButton}"
                                        Command="{Binding StopCommand}"
                                        ToolTip="정지">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconGlyph}"
                                                   Text="{StaticResource GlyphStop}"
                                                   FontSize="12"
                                                   Margin="0,0,6,0" />
                                        <TextBlock Text="정지" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource TransportButton}"
                                        Command="{Binding NextCommand}"
                                        ToolTip="다음">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconGlyph}"
                                                   Text="{StaticResource GlyphNext}"
                                                   FontSize="12"
                                                   Margin="0,0,6,0" />
                                        <TextBlock Text="다음" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <CheckBox Content="자동 다음"
                                          IsChecked="{Binding AutoAdvance}"
                                          Margin="14,0,0,0" />
                            </StackPanel>

                            <Border DockPanel.Dock="Right"
                                    Background="{StaticResource BgElevated}"
                                    BorderBrush="{StaticResource Line}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="8,4,10,4"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}"
                                            Command="{Binding ToggleMuteCommand}"
                                            Margin="0"
                                            Width="28"
                                            Height="28"
                                            VerticalAlignment="Center">
                                        <Button.ToolTip>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="음소거" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                <Setter Property="Text" Value="음소거 해제" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button.ToolTip>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
                                                    <Setter Property="Text" Value="{StaticResource GlyphVolume}" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                    <Setter Property="FontSize" Value="15" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                            <Setter Property="Text" Value="{StaticResource GlyphMute}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                    <Slider Style="{StaticResource VolumeSlider}"
                                            Width="110"
                                            Margin="4,0,0,0"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="{Binding Volume}"
                                            IsMoveToPointEnabled="True"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Volume, StringFormat={}{0:0}}"
                                               Width="24"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="12" />
                                </StackPanel>
                            </Border>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
